---
interface Props {
  eyebrow?: string;
  /** May contain <em> for the italic accent word. */
  title: string;
  text?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  class?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, text, align = 'left', tone = 'dark', class: className, as: Tag = 'h2' } = Astro.props;
---

<div class:list={[align === 'center' && 'mx-auto text-center', 'max-w-2xl', className]} data-reveal>
  {eyebrow && <p class:list={['eyebrow', tone === 'light' && 'eyebrow-light', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <Tag
    class:list={[
      'h-section mt-4 [&_em]:text-primary [&_em]:italic',
      tone === 'light' && 'text-white [&_em]:!text-accent',
    ]}
    set:html={title}
  />
  {text && <p class:list={['lead mt-5', tone === 'light' && '!text-white/70']}>{text}</p>}
  <slot />
</div>
