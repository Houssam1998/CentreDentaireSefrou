---
import Icon from '@/components/ui/Icon.astro';
import { type Lang, useT } from '@/i18n';
import { whatsappLink } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<!-- Desktop only: phones use the bottom action bar instead -->
<a
  href={whatsappLink(t('whatsapp.greeting'))}
  target="_blank"
  rel="noopener"
  data-cta="float-whatsapp"
  class="group fixed right-6 bottom-6 z-40 hidden items-center gap-3 lg:flex"
  aria-label={t('cta.whatsappChat')}
>
  <span
    class="pointer-events-none translate-x-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-ink opacity-0 shadow-soft transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
  >
    {t('whatsapp.tooltip')}
  </span>
  <span class="relative inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lift transition-transform duration-300 group-hover:scale-105">
    <span class="absolute inset-0 animate-ping rounded-full bg-whatsapp opacity-20 [animation-duration:2.5s]"></span>
    <Icon name="whatsapp" class="relative size-7" />
  </span>
</a>
