---
import Icon from '@/components/ui/Icon.astro';
import { type Lang, path, treatmentPath, useT } from '@/i18n';
import { site, fullAddress, whatsappLink } from '@/data/site';
import { treatments } from '@/data/treatments';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const nav = [
  { label: t('nav.home'), href: path('home', lang) },
  { label: t('nav.centre'), href: path('centre', lang) },
  { label: t('nav.doctor'), href: path('doctor', lang) },
  { label: t('nav.treatments'), href: path('treatments', lang) },
  { label: t('nav.beforeAfter'), href: path('beforeAfter', lang) },
  { label: t('nav.contact'), href: path('contact', lang) },
];
const featured = ['implants', 'veneers', 'aligners', 'smile-design', 'checkup', 'sleep-apnea', 'bruxism'];
const socials = [
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'tiktok', href: site.social.tiktok, label: 'TikTok' },
] as const;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink text-white/75">
  <!-- Logo-inspired contour lines -->
  <svg class="pointer-events-none absolute -top-24 -right-40 w-[44rem] text-white/[0.04]" viewBox="0 0 600 600" fill="none" aria-hidden="true">
    {Array.from({ length: 14 }, (_, i) => (
      <path d={`M${40 + i * 18} 560 C ${120 + i * 14} ${380 - i * 6}, ${80 + i * 22} ${200 - i * 4}, ${300 + i * 6} ${60 + i * 8} S ${520 - i * 4} ${180 + i * 6}, ${560 - i * 2} ${40 + i * 12}`} stroke="currentColor" stroke-width="1.2" />
    ))}
  </svg>

  <div class="container-site relative pt-16 pb-10 md:pt-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
      <div>
        <img src="/brand/logo-white.png" alt={site.name} width="551" height="386" class="w-44" loading="lazy" />
        <p class="mt-6 max-w-xs">{t('footer.tagline')}</p>
        <p class="mt-3 max-w-xs text-sm text-white/55">
          {lang === 'fr' ? 'Patients de ' : 'Welcoming patients from '}{site.areaServed.join(', ')}.
        </p>
        <p lang="ar" dir="rtl" class="mt-3 max-w-xs text-sm text-white/55">{site.nameAr} — طبيب أسنان في صفرو</p>
        <div class="mt-6 flex gap-2">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="inline-flex size-11 items-center justify-center rounded-full border border-white/15 transition-colors hover:border-accent hover:text-accent"
                aria-label={s.label}
              >
                <Icon name={s.name} class="size-[1.15rem]" />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-5 font-serif text-xl text-white">{t('footer.navigation')}</p>
        <ul class="space-y-1">
          {nav.map((n) => <li><a href={n.href} class="inline-flex min-h-10 items-center transition-colors hover:text-accent">{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="mb-5 font-serif text-xl text-white">{t('footer.treatments')}</p>
        <ul class="space-y-1">
          {
            treatments
              .filter((tr) => featured.includes(tr.id))
              .map((tr) => (
                <li>
                  <a href={treatmentPath(tr[lang].slug, lang)} class="inline-flex min-h-10 items-center transition-colors hover:text-accent">
                    {tr[lang].title}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>

      <div>
        <p class="mb-5 font-serif text-xl text-white">{t('footer.contact')}</p>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <Icon name="mapPin" class="mt-0.5 size-5 shrink-0 text-accent" />
            <span>{fullAddress}</span>
          </li>
          <li>
            <a href={site.phoneHref} class="flex gap-3 transition-colors hover:text-accent" data-cta="footer-call">
              <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-accent" />{site.phone}
            </a>
          </li>
          <li>
            <a href={whatsappLink(t('whatsapp.greeting'))} target="_blank" rel="noopener" class="flex gap-3 transition-colors hover:text-accent" data-cta="footer-whatsapp">
              <Icon name="whatsapp" class="mt-0.5 size-5 shrink-0 text-accent" />{site.whatsappDisplay}
            </a>
          </li>
          <li class="flex gap-3">
            <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-accent" />
            <span class="grid gap-1">
              {
                site.hours.map((h) => (
                  <span>
                    <span class="text-white">{h.days[lang]}</span> · {h.time?.join(' · ') ?? t('footer.closed')}
                  </span>
                ))
              }
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-white/50 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name} — {site.doctor}. {t('footer.rights')}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={path('legal', lang)} class="hover:text-white">{t('footer.legal')}</a>
        <a href="/media/CREDITS.md" class="hover:text-white">{t('footer.credits')}</a>
      </div>
    </div>
  </div>
</footer>
