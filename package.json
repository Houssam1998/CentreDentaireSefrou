{
  "name": "centre-dentaire-sefrou",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-reviews.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ig:studio": "vite --config instagram/vite.config.js --open",
    "ig:render": "node instagram/scripts/render.mjs",
    "ig:reel": "node instagram/scripts/reel.mjs",
    "ig:build": "vite build --config instagram/vite.config.js",
    "ig:check": "tsc -p instagram && tsc -p instagram/worker",
    "ig:deploy": "npm run ig:build && wrangler d1 migrations apply DB --remote --config instagram/wrangler.jsonc && wrangler deploy --config instagram/wrangler.jsonc",
    "ig:test": "node instagram/worker/auth.test.mjs && node instagram/worker/ai.test.mjs && node instagram/scripts/regress.mjs && node instagram/scripts/e2e.mjs && node instagram/scripts/e2e-wizard.mjs && node instagram/scripts/e2e-ai.mjs",
    "ig:cloud": "npm run ig:build && wrangler d1 migrations apply DB --local --config instagram/wrangler.jsonc && wrangler dev --config instagram/wrangler.jsonc --port 8788",
    "ig:setup": "node instagram/scripts/setup-cloud.mjs",
    "ig:test:team": "node instagram/scripts/e2e-team.mjs",
    "site:check": "tsc -p site-worker",
    "site:test": "node site-worker/reviews.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.9",
    "moveable": "^0.53.0",
    "nanoid": "^6.0.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selecto": "^1.26.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
