// Cloudflare Workers deployment: serves the static build in ./dist
// (the name must match the Worker / project name in the Cloudflare dashboard)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centredentairesefrou",
  "compatibility_date": "2026-10-01",
  // Custom domains: Cloudflare creates the DNS records and the HTTPS certificates on deploy
  // (the bare domain is then redirected to www by a Redirect Rule in the dashboard)
  "routes": [
    { "pattern": "www.centredentairesefrou.com", "custom_domain": true },
    { "pattern": "centredentairesefrou.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Unknown URLs show the site's own 404 page
    "not_found_handling": "404-page",
    // Every page lives at a URL ending in "/" (matches trailingSlash: 'always' in astro.config.mjs)
    "html_handling": "auto-trailing-slash"
  }
}
