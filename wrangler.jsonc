// Cloudflare Workers deployment: serves the static build in ./dist
// (the name must match the Worker / project name in the Cloudflare dashboard)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centredentairesefrou",
  "compatibility_date": "2026-10-01",
  // Small Worker for /api/* only (Google reviews refreshed every night). Every page is still served as a static file.
  "main": "./site-worker/index.ts",
  // Custom domains: Cloudflare creates the DNS records and the HTTPS certificates on deploy
  // (the bare domain is then redirected to www by a Redirect Rule in the dashboard)
  "routes": [
    { "pattern": "www.centredentairesefrou.com", "custom_domain": true },
    { "pattern": "centredentairesefrou.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; everything else goes straight to the static files
    "run_worker_first": ["/api/*"],
    // Unknown URLs show the site's own 404 page
    "not_found_handling": "404-page",
    // Every page lives at a URL ending in "/" (matches trailingSlash: 'always' in astro.config.mjs)
    "html_handling": "auto-trailing-slash"
  },
  // Storage for the Google reviews (replaced every night), created on 22/11/2026 with
  // `npx wrangler kv namespace create REVIEWS`. Without it the site still works (curated reviews only).
  "kv_namespaces": [{ "binding": "REVIEWS", "id": "5bb48f770fba41059efce2eca2f439e4" }],
  // Every night at 04:00 UTC (05:00 in Morocco): refresh the Google reviews
  "triggers": { "crons": ["0 4 * * *"] }
  // Secret (never in this file): npx wrangler secret put GOOGLE_PLACES_KEY
}
